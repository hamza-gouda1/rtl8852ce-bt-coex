#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# bt-afh-guard — persistent direct-AFH coexistence fix for the Realtek RTL8852CE
# Part of rtl8852ce-bt-coex by Hamza Gouda (GPL-2.0)
#
# Problem: on Linux the RTL8852CE's Wi-Fi and Bluetooth firmware never complete
# their coexistence handshake (BT reports coex v0, Wi-Fi wants v7), so the
# Bluetooth controller is never told which channels the Wi-Fi link occupies and
# keeps hopping straight through it (see docs/ROOT-CAUSE.md).
#
# Fix: hand the BT controller the "avoid these channels" map ourselves, using the
# standard HCI command  Set AFH Host Channel Classification  (OGF 0x03, OCF 0x003F).
#
# Bitmask (Core Spec Vol 4 Part E §7.3.46): 80 bits, bit n = BT channel n
# (2402 + n MHz). 1 = "unknown" (usable), 0 = "bad" (avoid). Bit 79 is reserved
# and must be 0. At least 20 channels must stay usable.
#
# The daemon checks every INTERVAL seconds, follows Wi-Fi channel/width changes
# across all wireless interfaces, re-sends after controller resets, and clears
# the mask when Wi-Fi leaves 2.4 GHz.
# Optional overrides: /etc/default/bt-afh-guard (GUARD_MHZ, INTERVAL, REFRESH, HCI)

GUARD_MHZ=2          # extra margin on each side of the Wi-Fi block
INTERVAL=5           # seconds between checks
REFRESH=60           # re-send even if unchanged (covers silent controller resets)
HCI=hci0
# shellcheck disable=SC1091  # /etc/default/bt-afh-guard only exists on installed systems
[ -r /etc/default/bt-afh-guard ] && . /etc/default/bt-afh-guard

last=""; last_sent=0
log() { logger -t bt-afh-guard "$*"; }

# ---------------------------------------------------------------------------
# Pure, testable layer. These functions take explicit input (or read iw) and
# print results; tests/run.sh sources this file and asserts exact outputs.
# ---------------------------------------------------------------------------

iface_list() {   # print wireless interface names from `iw dev`
    iw dev 2>/dev/null | awk '/Interface/{print $2}'
}

parse_iw_info() {   # $1 = full "iw dev <if> info" output; prints "center width" (MHz), or "" when there is no channel line
    local info=$1 freq="" center="" width=""
    freq=$(sed -n 's/.*channel [0-9]* (\([0-9]*\) MHz).*/\1/p' <<<"$info")
    [ -z "$freq" ] && return 0
    width=$(sed -n 's/.*width: \([0-9]*\) MHz.*/\1/p' <<<"$info")
    center=$(sed -n 's/.*center1: \([0-9]*\) MHz.*/\1/p' <<<"$info")
    # Old iw prints no width (20 MHz) and no center1 for 20 MHz links.
    # If a wider link reports no center1 the extension channel side is unknown;
    # fall back to the control frequency as center, which over-blocks one side
    # (safe for coexistence, never under-blocks).
    width=${width:-20}
    center=${center:-$freq}
    echo "$center $width"
}

wifi_block() {   # union of the occupied 2.4 GHz blocks of every interface (with GUARD_MHZ margin each side); prints "lo hi" MHz, or "" when no 2.4 GHz link
    local ifc info center width lo hi
    local glo="" ghi=""
    for ifc in $(iface_list); do
        info=$(iw dev "$ifc" info 2>/dev/null) || continue
        read -r center width <<<"$(parse_iw_info "$info")"
        [ -z "$center" ] && continue
        (( center >= 2500 )) && continue   # 5/6 GHz links cannot collide with Bluetooth's 2.4 GHz band
        lo=$(( center - width/2 - GUARD_MHZ ))
        hi=$(( center + width/2 + GUARD_MHZ ))
        if [ -z "$glo" ]; then
            glo=$lo; ghi=$hi
        else
            (( lo < glo )) && glo=$lo
            (( hi > ghi )) && ghi=$hi
        fi
    done
    [ -n "$glo" ] && echo "$glo $ghi"
}

build_mask() {   # $1 lo MHz, $2 hi MHz (empty = no Wi-Fi block) -> prints 10 hex bytes, LSB first; bit 79 reserved = 0
    local -a M=(255 255 255 255 255 255 255 255 255 127)   # channels 0-78 usable, bit 79 = 0
    if [ -n "$1" ]; then
        local lo=$(( $1 - 2402 )) hi=$(( $2 - 2402 )) n
        (( lo < 0 )) && lo=0
        (( hi > 78 )) && hi=78
        # Refuse masks that would leave fewer than 20 usable channels
        # (invalid per spec; the controller would reject them).
        if (( 79 - (hi - lo + 1) >= 20 )); then
            for ((n=lo; n<=hi; n++)); do M[n/8]=$(( M[n/8] & ~(1<<(n%8)) )); done
        fi
    fi
    local out="" b; for b in "${M[@]}"; do out+=" $(printf '0x%02X' "$b")"; done; echo "${out# }"
}

mask_usable_count() {   # $1 = mask string ("0xXX ..." 10 bytes, LSB first) -> number of usable channels (bits 0-78; reserved bit 79 excluded)
    local -a M
    read -r -a M <<<"$1"
    local count=0 n b
    for ((n=0; n<79; n++)); do
        b=${M[n/8]}
        (( b & (1 << (n%8)) )) && count=$((count+1))
    done
    echo "$count"
}

# The all-usable classification (no Wi-Fi block): channels 0-78 usable, bit 79 = 0.
ALL_USABLE="0xFF 0xFF 0xFF 0xFF 0xFF 0xFF 0xFF 0xFF 0xFF 0x7F"

# ---------------------------------------------------------------------------
# Verified HCI sender. `hcitool cmd` exits 0 even when the controller rejects
# the command; the verdict is in the Command Complete event's status byte.
# scripts/hci-cmd.py (preferred) waits for that event natively and exits with
# the status byte; the hcitool fallback parses the status from hcitool's own
# event dump. Both set HCI_STATUS ("0xNN" on an HCI-level verdict, "" when no
# verdict was received) and return 0 only for status 0x00.
# ---------------------------------------------------------------------------

HCI_CMD_PY=""
HCI_BACKEND=""
hci_backend() {   # pick the verified-sender backend once; returns 0 when one exists
    local dir here
    here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    for dir in "$here" /usr/local/lib/bt-afh-guard /usr/local/share/bt-afh-guard; do
        if [ -x "$dir/hci-cmd.py" ]; then
            HCI_CMD_PY="$dir/hci-cmd.py"
            HCI_BACKEND="hci-cmd.py ($dir/hci-cmd.py)"
            return 0
        fi
    done
    if command -v hcitool >/dev/null 2>&1; then
        HCI_BACKEND="hcitool (status parsed from the Command Complete dump)"
        return 0
    fi
    return 1
}

hcitool_cc_status() {   # $1 = full hcitool cmd output; $2 = opcode lo byte, $3 = opcode hi byte (hex, no 0x prefix); prints "0xNN [params as 0xNN ...]" or "NO-CC"/"OPCODE-MISMATCH"
    awk -v lo="$2" -v hi="$3" '
        / HCI Event: Command Complete/ {inc = 1; next}
        inc && /^[<>]/ {exit}
        inc {
            for (i = 1; i <= NF; i++)
                if ($i ~ /^[0-9A-Fa-f][0-9A-Fa-f]$/) { k++; b[k] = toupper($i) }
        }
        END {
            if (k >= 4) {
                if (b[2] == toupper(lo) && b[3] == toupper(hi)) {
                    s = "0x" b[4]
                    for (i = 5; i <= k; i++) s = s " 0x" b[i]
                    print s
                } else {
                    print "OPCODE-MISMATCH"
                }
            } else {
                print "NO-CC"
            }
        }' <<<"$1"
}

hci_send() {   # HCI OGF OCF [PARAMS...] -> prints return params on stdout; sets HCI_STATUS ("0xNN" or "" when no verdict); returns 0 iff the controller accepted (status 0x00)
    HCI_STATUS=""
    local dev=$1 ogf=$2 ocf=$3
    shift 3
    local out rc first parsed
    if [ -n "$HCI_CMD_PY" ]; then
        out=$("$HCI_CMD_PY" --hci "$dev" "$ogf" "$ocf" "$@" 2>/dev/null)
        rc=$?
        first=${out%%$'\n'*}
        if [[ "$first" == status\ 0x* ]]; then
            HCI_STATUS=${first#status }
        fi
        parsed=${out#*$'\n'}
        [ "$parsed" = "$out" ] && parsed=""
        printf '%s\n' "$parsed"
        [ "$rc" -eq 0 ] && return 0
        return 1
    fi
    # hcitool fallback: `hcitool cmd` exits 0 even for rejected commands, so the
    # status byte and return parameters are parsed from the event dump.
    out=$(hcitool -i "$dev" cmd "$ogf" "$ocf" "$@" 2>&1) || { echo "hcitool transport failure" >&2; return 1; }
    local op lo hi st
    op=$(( (ogf << 10) | ocf ))
    lo=$(printf '%02X' $(( op & 0xFF )))
    hi=$(printf '%02X' $(( (op >> 8) & 0xFF )))
    st=$(hcitool_cc_status "$out" "$lo" "$hi")
    if [ "$st" = "NO-CC" ] || [ "$st" = "OPCODE-MISMATCH" ]; then
        echo "no Command Complete verdict for opcode 0x$hi$lo" >&2
        return 1
    fi
    HCI_STATUS=${st%% *}
    if [ "${st%% *}" != "0x00" ]; then
        echo "HCI status ${st%% *}" >&2
        return 1
    fi
    parsed=${st#* }
    [ "$parsed" = "$st" ] && parsed=""   # no space: the Command Complete had no return parameters
    printf '%s\n' "$parsed"
    return 0
}

controller_alive() {   # returns 0 when $HCI answers Read_Local_Version_Info (read-only) via the verified sender
    hci_send "$HCI" 0x04 0x0001 >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Live-map readback (HCI_Read_AFH_Channel_Map, OGF 0x05 / OCF 0x0006, per ACL
# handle). Bit n = 1 means the controller's hop map currently uses channel n.
# ---------------------------------------------------------------------------

list_acl_handles() {   # prints connected ACL handles, one per line; empty when nothing is connected or no enumerator exists
    local line
    if command -v hcitool >/dev/null 2>&1; then
        hcitool con 2>/dev/null | grep -oP 'ACL .*handle \K[0-9]+' || true
        return 0
    fi
    if [ -n "$HCI_CMD_PY" ]; then
        while IFS= read -r line; do
            if [[ "$line" == handle\ * && "$line" == *"type 1 "* ]]; then
                line=${line#handle }; echo ${line%% *}
            fi
        done < <("$HCI_CMD_PY" --list-conns --hci "$HCI" 2>/dev/null)
    fi
}

read_live_map() {   # $1 = ACL handle; prints the live AFH map as 10 hex bytes, or returns 1 on failure
    local out i m=""
    out=$(hci_send "$HCI" 0x05 0x0006 "$(printf '0x%02X' $(( $1 & 0xFF )))" "$(printf '0x%02X' $(( ($1 >> 8) & 0xFF )))" 2>/dev/null) || return 1
    local -a p
    read -r -a p <<<"$out"
    [ "${#p[@]}" -ge 12 ] || return 1
    for ((i = 2; i < 12; i++)); do
        m+=" ${p[i]}"
    done
    echo "${m# }"
}

overlap_count() {   # $1 = live map (10 hex bytes), $2 lo MHz, $3 hi MHz -> number of live channels inside the block
    local -a M
    read -r -a M <<<"$1"
    local lo=$(( $2 - 2402 )) hi=$(( $3 - 2402 )) n c=0
    (( lo < 0 )) && lo=0
    (( hi > 78 )) && hi=78
    for ((n = lo; n <= hi; n++)); do
        (( M[n/8] & (1 << (n%8)) )) && c=$((c+1))
    done
    echo "$c"
}

report_live_maps() {   # $1 lo MHz, $2 hi MHz ("" = no Wi-Fi block); prints one compact line per connected ACL handle
    local h m used ovl
    for h in $(list_acl_handles); do
        m=$(read_live_map "$h") || { echo "live map handle $h: read failed (status ${HCI_STATUS:-no verdict})"; continue; }
        used=$(mask_usable_count "$m")
        if [ -n "$1" ]; then
            ovl=$(overlap_count "$m" "$1" "$2")
            echo "live map handle $h: $used ch used, $ovl overlap with Wi-Fi $1-$2 MHz"
        else
            echo "live map handle $h: $used ch used, no Wi-Fi block"
        fi
    done
}

log_live_maps() {   # $1 lo MHz, $2 hi MHz; logs report_live_maps output to the journal
    local line
    while IFS= read -r line; do
        [ -n "$line" ] && log "$line"
    done < <(report_live_maps "$1" "$2")
}

# ---------------------------------------------------------------------------
# Main program. Guarded so tests can source this file without starting the loop.
# ---------------------------------------------------------------------------

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then

    # --dry-run: print what would be sent and exit (no root needed)
    if [ "${1:-}" = "--dry-run" ]; then
        read -r lo hi <<<"$(wifi_block)"
        mask=$(build_mask "$lo" "$hi")
        usable=$(mask_usable_count "$mask")
        echo "Wi-Fi block: ${lo:-none}-${hi:-none} MHz"
        if [ -n "$lo" ] && [ "$mask" = "$ALL_USABLE" ]; then
            echo "WARNING: the Wi-Fi block would leave fewer than 20 usable channels;"
            echo "         sending the all-usable map instead (cannot honor the block)"
        fi
        echo "HCI mask: $mask ($usable/79 channels usable)"
        exit 0
    fi

    # --status: Wi-Fi block, host mask, backend, and each link's live map (root)
    if [ "${1:-}" = "--status" ]; then
        hci_backend || true
        if [ -z "$HCI_BACKEND" ]; then
            echo "no verified HCI backend (scripts/hci-cmd.py or bluez hcitool needed)"
            exit 1
        fi
        echo "backend: $HCI_BACKEND"
        read -r lo hi <<<"$(wifi_block)"
        echo "Wi-Fi block: ${lo:-none}-${hi:-none} MHz"
        echo "Host mask: $(build_mask "$lo" "$hi")"
        report_live_maps "$lo" "$hi"
        exit 0
    fi

    hci_backend || true
    if [ -z "$HCI_BACKEND" ]; then
        log "no verified HCI backend (scripts/hci-cmd.py or bluez hcitool needed); idling"
        while :; do sleep "$INTERVAL"; done
    fi
    log "verified HCI sender backend: $HCI_BACKEND"

    was_up=0; force=0
    while true; do
        if controller_alive; then
            if [ "$was_up" -eq 0 ]; then
                log "controller $HCI is up"
                force=1   # re-send after any controller outage (reset, restart, resume)
            fi
            was_up=1
            read -r lo hi <<<"$(wifi_block)"
            mask=$(build_mask "$lo" "$hi")
            now=$(date +%s)
            if [ "$mask" != "$last" ] || [ "$force" -eq 1 ]; then
                if [ -n "$lo" ] && [ "$mask" = "$ALL_USABLE" ]; then
                    log "WARNING: the Wi-Fi block would leave fewer than 20 usable channels; sending the all-usable map instead"
                fi
                if hci_send "$HCI" 0x03 0x003F $mask >/dev/null; then
                    [ "$mask" != "$last" ] && log "avoiding ${lo:-none}-${hi:-none} MHz; mask: $mask"
                    last="$mask"; last_sent=$now
                    log_live_maps "$lo" "$hi"   # verify: read the live controller map back per link
                else
                    if [ -n "$HCI_STATUS" ]; then
                        log "AFH set rejected: status $HCI_STATUS"
                    else
                        log "AFH set failed: no HCI verdict (transport failure)"
                    fi
                fi
                force=0
            elif (( now - last_sent >= REFRESH )); then
                if hci_send "$HCI" 0x03 0x003F $mask >/dev/null; then
                    last_sent=$now
                    log_live_maps "$lo" "$hi"   # refresh re-send: also read back and log the live map
                else
                    log "AFH refresh failed: status ${HCI_STATUS:-no verdict}"
                fi
            fi
        else
            if [ "$was_up" -eq 1 ]; then
                log "controller $HCI down; will re-send when it returns"
            fi
            was_up=0
        fi
        sleep "$INTERVAL"
    done

fi
