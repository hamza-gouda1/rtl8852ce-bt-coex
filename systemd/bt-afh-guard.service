[Unit]
Description=Keep Bluetooth hopping away from the active 2.4 GHz Wi-Fi channel (RTL8852CE coex fix)
Documentation=https://github.com/hamza-gouda1/rtl8852ce-bt-coex
After=bluetooth.service NetworkManager.service
Wants=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/bt-afh-guard
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
