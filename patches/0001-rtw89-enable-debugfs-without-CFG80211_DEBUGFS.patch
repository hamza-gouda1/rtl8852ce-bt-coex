From: Hamza Gouda <hraafat357@gmail.com>
Subject: [PATCH] rtw89: enable debugfs without CFG80211_DEBUGFS

--- a/drivers/net/wireless/realtek/rtw89/debug.c
+++ b/drivers/net/wireless/realtek/rtw89/debug.c
@@ -143,6 +143,60 @@
 	return n;
 }
 
+#ifdef CONFIG_CFG80211_DEBUGFS
+#define rtw89_debugfs_wiphy_read wiphy_locked_debugfs_read
+#define rtw89_debugfs_wiphy_write wiphy_locked_debugfs_write
+#else
+/* cfg80211's locked debugfs helpers are only compiled with
+ * CONFIG_CFG80211_DEBUGFS. Provide the same user-copy + handler-under-wiphy-
+ * lock semantics with plain wiphy_lock() in syscall context; unlike the
+ * cfg80211 work-based variant these reads are not cancellable while blocked,
+ * acceptable for short debug handlers. */
+static ssize_t
+rtw89_debugfs_wiphy_read(struct wiphy *wiphy, struct file *file,
+			 char *buf, size_t bufsize,
+			 char __user *userbuf, size_t count,
+			 loff_t *ppos,
+			 ssize_t (*handler)(struct wiphy *wiphy,
+					    struct file *file,
+					    char *buf, size_t bufsize,
+					    void *data),
+			 void *data)
+{
+	ssize_t n;
+
+	memset(buf, 0, bufsize);
+	wiphy_lock(wiphy);
+	n = handler(wiphy, file, buf, bufsize, data);
+	wiphy_unlock(wiphy);
+
+	return simple_read_from_buffer(userbuf, count, ppos, buf, n);
+}
+
+static ssize_t
+rtw89_debugfs_wiphy_write(struct wiphy *wiphy, struct file *file,
+			  char *buf, size_t bufsize,
+			  const char __user *userbuf, size_t count,
+			  ssize_t (*handler)(struct wiphy *wiphy,
+					     struct file *file,
+					     char *buf, size_t count,
+					     void *data),
+			  void *data)
+{
+	ssize_t n;
+
+	memset(buf, 0, bufsize);
+	if (copy_from_user(buf, userbuf, count))
+		return -EFAULT;
+
+	wiphy_lock(wiphy);
+	n = handler(wiphy, file, buf, count, data);
+	wiphy_unlock(wiphy);
+
+	return n;
+}
+#endif /* CONFIG_CFG80211_DEBUGFS */
+
 static ssize_t rtw89_debugfs_file_read(struct file *file, char __user *userbuf,
 				       size_t count, loff_t *ppos)
 {
@@ -166,10 +220,10 @@
 	}
 
 	if (opt->rlock) {
-		n = wiphy_locked_debugfs_read(rtwdev->hw->wiphy, file, buf, bufsz,
-					      userbuf, count, ppos,
-					      rtw89_debugfs_file_read_helper,
-					      debugfs_priv);
+		n = rtw89_debugfs_wiphy_read(rtwdev->hw->wiphy, file, buf, bufsz,
+					     userbuf, count, ppos,
+					     rtw89_debugfs_file_read_helper,
+					     debugfs_priv);
 		debugfs_priv->rused = n;
 
 		return n;
@@ -206,11 +260,11 @@
 		return -ENOMEM;
 
 	if (opt->wlock) {
-		n = wiphy_locked_debugfs_write(rtwdev->hw->wiphy,
-					       file, buf, count + 1,
-					       userbuf, count,
-					       rtw89_debugfs_file_write_helper,
-					       debugfs_priv);
+		n = rtw89_debugfs_wiphy_write(rtwdev->hw->wiphy,
+					      file, buf, count + 1,
+					      userbuf, count,
+					      rtw89_debugfs_file_write_helper,
+					      debugfs_priv);
 		return n;
 	}
 
@@ -4956,13 +5010,26 @@
 {
 	struct dentry *debugfs_topdir;
 
+	pr_info("rtw89: debugfs_init enter\n");
+
 	rtwdev->debugfs = kmemdup(&rtw89_debugfs_templ,
 				  sizeof(rtw89_debugfs_templ), GFP_KERNEL);
 	if (!rtwdev->debugfs)
 		return;
 
-	debugfs_topdir = debugfs_create_dir("rtw89",
-					    rtwdev->hw->wiphy->debugfsdir);
+	/* Out-of-tree: the wiphy debugfs dir does not exist without
+	 * CONFIG_CFG80211_DEBUGFS, so mount the tree at the debugfs root.
+	 * Fixed name keeps this independent of device registration
+	 * lifetime; collisions only matter for multi-card hosts. */
+	debugfs_topdir = debugfs_create_dir("rtw89", NULL);
+	if (IS_ERR_OR_NULL(debugfs_topdir)) {
+		rtw89_warn(rtwdev, "failed to create debugfs dir (%ld)\n",
+			   PTR_ERR(debugfs_topdir));
+		return;
+	}
+
+	pr_info("rtw89: debugfs dir created at /sys/kernel/debug/rtw89 (%px)\n",
+		debugfs_topdir);
 
 	rtw89_debugfs_add_sec0(rtwdev, debugfs_topdir);
 	rtw89_debugfs_add_sec1(rtwdev, debugfs_topdir);

Signed-off-by: Hamza Gouda <hraafat357@gmail.com>
